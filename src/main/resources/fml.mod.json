{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Adds vanilla-style shields and a shield registration API for MITE.",
  "authors": [
    "postyizhan"
  ],
  "license": "CC0-1.0",
  "icon": "assets/shieldmite/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.postyizhan.shieldmite.ShieldMite"
    ],
